# Sample env. Copy to `.env` for local dev. NEVER commit `.env`.
# All values shown are placeholders or non-secret references.

# === Copilot Studio orders agent (created in Phase 1, see docs/02-cs-orders-setup.md) ===
# Target Power Platform environment:
#   Org URL:        https://orga5bae564.crm.dynamics.com
#   Org ID:         1870688f-653b-f111-83fa-6045bd023806
#   Environment ID: 63b4b29b-b3b0-ed70-9136-524a53a22e06
#   Region:         United States  (DL conv ids carry suffix '-us')
# After CS provisioning, the env API host should be:
#   63b4b29bb3b0ed709136524a53a22e.06.environment.api.powerplatform.com
CS_DIRECTLINE_TOKEN_ENDPOINT=
CS_AGENT_SCHEMA_NAME=
CS_AGENT_APP_ID=
CS_ENVIRONMENT_API_HOST=63b4b29bb3b0ed709136524a53a22e.06.environment.api.powerplatform.com

# === Mock orders API (in-repo FastAPI under orders_api/) ===
# In dev, exposed via devtunnel; in prod, internal ACA URL or behind same ingress.
ORDERS_API_BASE_URL=http://localhost:8000

# === Foundry / Azure OpenAI ===
# Existing AI Services account `awm-ai-svc` in AWM_z2025_Demo_RG (eastus).
# Auth via DefaultAzureCredential (RBAC: Cognitive Services OpenAI User).
FOUNDRY_PROJECT_ENDPOINT=https://awm-ai-svc.openai.azure.com/
FOUNDRY_AGENT_ID=
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini-gp
FOUNDRY_API_VERSION=2024-10-21

# === Backend selector ===
# "directline" (Phase 2 fallback, default) or "a2a" (Phase 3 primary, optional).
CS_BACKEND=directline

# === Flask app ===
FLASK_ENV=development
PORT=5000
LOG_LEVEL=INFO

# === Public URL (devtunnel in dev, ACA FQDN in prod) ===
BRIDGE_PUBLIC_URL=

# === Optional: correlation id propagation (Phase 4) ===
ENABLE_TRACE_HEADERS=true

# === Optional: Application Insights (Phase 4) ===
APPLICATIONINSIGHTS_CONNECTION_STRING=
