# Sample env. Copy to `.env` for local dev. NEVER commit `.env`.
# All values shown are placeholders or non-secret references.

# === Copilot Studio (existing Order Management System Agent) ===
# Parent agent: "Order Management System Agent" from SterlingOMS_Template.
# Schema: new_bot_dc222ce70439f11188b36045bdf0ef76 (AAD app: 5c3eebd1-d965-4bb9-b3e9-afe262e891bc)
# Unauthenticated; Direct Line token endpoint is publicly callable.
CS_DIRECTLINE_TOKEN_ENDPOINT=https://63b4b29bb3b0ed709136524a53a22e.06.environment.api.powerplatform.com/powervirtualagents/botsbyschema/new_bot_dc222ce70439f11188b36045bdf0ef76/directline/token?api-version=2022-03-01-preview

# === Foundry Agent Service ===
# Filled in Phase 2 once the Foundry project + agent exist.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_ID=
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini

# === Backend selector ===
# "directline" (Phase 2 fallback, default) or "a2a" (Phase 3 primary, optional).
CS_BACKEND=directline

# === Flask app ===
FLASK_ENV=development
PORT=5000
LOG_LEVEL=INFO

# === Public URL (devtunnel in dev, ACA FQDN in prod) ===
BRIDGE_PUBLIC_URL=

# === Optional: correlation id propagation (Phase 4) ===
ENABLE_TRACE_HEADERS=true

# === Optional: Application Insights (Phase 4) ===
APPLICATIONINSIGHTS_CONNECTION_STRING=
